---
import '../../styles/global.css'
import NewsSearch from '../../components/NewsSearch.astro'
import {getNewsList} from '../../lib/sanity/queries'
import {withBase} from '../../lib/url'

const news = await getNewsList()
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>お知らせ</title>
  </head>
  <body>
    <main class="mx-auto max-w-2xl p-8">
      <h1 class="text-2xl font-bold mb-6">お知らせ</h1>
      {/* 全文検索の方式比較用（実験）。A: ビルド時インデックス / B: Sanity へ直接問い合わせ */}
      <div class="mb-8 grid gap-4 md:grid-cols-2">
        <NewsSearch
          engine="pagefind"
          label="A. Pagefind 検索"
          description="ビルド時に生成した静的インデックスをブラウザで検索"
        />
        <NewsSearch
          engine="sanity"
          label="B. Sanity 直接検索"
          description="ブラウザから Content Lake に GROQ で問い合わせ"
        />
      </div>
      {news.length === 0 ? (
        <p>お知らせはまだありません。</p>
      ) : (
        <ul class="space-y-4">
          {news.map((item) => (
            <li class="border-b pb-4">
              <a href={withBase(`/news/${item.slug?.current}`)} class="block">
                <p class="text-sm text-gray-500">
                  {item.publishedAt && new Date(item.publishedAt).toLocaleDateString('ja-JP')}
                  {item.category?.title && ` ・ ${item.category.title}`}
                </p>
                <h2 class="text-lg font-semibold underline">{item.title}</h2>
                {item.excerpt && <p class="text-gray-700">{item.excerpt}</p>}
              </a>
            </li>
          ))}
        </ul>
      )}
      <a href={withBase('/')} class="mt-8 inline-block underline">
        トップへ戻る
      </a>
    </main>
  </body>
</html>
